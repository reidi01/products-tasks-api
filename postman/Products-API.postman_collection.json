{
  "info": {
    "name": "Products API",
    "_postman_id": "b6f3a2e0-6c7a-4a1a-9d2a-9e3f1b7c1e10",
    "description": "Lab 8 — Rxpress Products API. Endpoints for managing products (in-memory store).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseURL", "value": "http://localhost:5001/api/products" }
  ],
  "item": [
    {
      "name": "Get All Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseURL}}", "host": ["{{baseURL}}"] }
      }
    },
    {
      "name": "Search Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseURL}}/search?q=laptop",
          "host": ["{{baseURL}}"],
          "path": ["search"],
          "query": [{ "key": "q", "value": "laptop" }]
        }
      }
    },
    {
      "name": "Get Single Product",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseURL}}/1", "host": ["{{baseURL}}"], "path": ["1"] }
      }
    },
    {
      "name": "Create Product",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Laptop Dell XPS 15\",\n  \"price\": 1499.99,\n  \"category\": \"Electronics\",\n  \"stock\": 12\n}"
        },
        "url": { "raw": "{{baseURL}}", "host": ["{{baseURL}}"] }
      }
    },
    {
      "name": "Create Product - Missing Name (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 999,\n  \"category\": \"Books\"\n}"
        },
        "url": { "raw": "{{baseURL}}", "host": ["{{baseURL}}"] }
      }
    },
    {
      "name": "Update Product",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 1299.99,\n  \"stock\": 10\n}"
        },
        "url": { "raw": "{{baseURL}}/1", "host": ["{{baseURL}}"], "path": ["1"] }
      }
    },
    {
      "name": "Delete Product",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseURL}}/1", "host": ["{{baseURL}}"], "path": ["1"] }
      }
    }
  ]
}
